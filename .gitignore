# Cutwright -- what is NOT in this repo
#
# Cutwright is mostly glue around two published binaries and a model. All three
# are downloaded by the user, verified against the publisher's own digest, and
# kept out of git: they are 1.2 GB together, and none of them is mine to
# redistribute. PROVENANCE.md records the exact URLs, sizes and sha256s.
#
# Each one is optional at runtime. `cutwright doctor` reports what is missing and
# what stops working without it -- probe/subs/transcribe need whisper, the engine
# needs Kinocut in `.venvs/kinocut`.

# whisper.cpp weights. ggml-small.en.bin alone is 465 MB.
/models/

# whisper.cpp Windows build (whisper-cli.exe + DLLs) plus the .zip it came from.
/bin/

# Source footage. 35 MB for the one clip the demo cuts from, and it is not mine
# to publish -- rebuild any plan against your own footage instead.
/testclips/

# Transcripts, extracted frames, scratch renders.
/out/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/dist/

# --- secrets and local overrides ---------------------------------------------
keys.env
.env
*.key
*.pem
*.local.json

# --- os / editor -------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Recap Studio engine (recapstudio/) --------------------------------------
# Secrets, installed engines/models, user media and generated output stay local.
recapstudio/keys.env
recapstudio/*.env
!recapstudio/keys.env.example
recapstudio/venvs/
recapstudio/models/
recapstudio/Projects/*
!recapstudio/Projects/.gitkeep
!recapstudio/Projects/_projects_go_here.txt
recapstudio/_voicelab/
recapstudio/voices/*
!recapstudio/voices/README.txt
recapstudio/remotion/node_modules/
recapstudio/remotion/package-lock.json.bak
recapstudio/remotion/src/generated/s_*.tsx
*.part

# --- Kinocut-first architecture (2026-10-29) -----------------------------------
# Isolated Kinocut environment, benchmark installs, per-run work files.
/.venvs/
/bench/
/production/*/work/
/out/
