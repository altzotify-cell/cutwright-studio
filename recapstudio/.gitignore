# secrets - NEVER commit
keys.env
*.env
!keys.env.example

# installed engines + downloaded models (several GB, recreated by SETUP.bat)
venvs/
models/

# your work
Projects/*
!Projects/.gitkeep
# M8: the m8_feature production IS the evidence for the milestone - its brief, blueprint, manifest,
# script and the narration's word timings are committed; its media (wav/mp3, the final mp4) is not.
!Projects/m8_feature/
Projects/m8_feature/*.mp4
Projects/m8_feature/audio/*.wav
Projects/m8_feature/audio/*.mp3
_voicelab/

# reference voices you cloned (personal recordings)
voices/*
!voices/README.txt

__pycache__/
*.pyc
*.part

# Remotion install
remotion/node_modules/
remotion/package-lock.json.bak

# generated by scenes.py (the empty default registry.ts ships with the project)
remotion/src/generated/s_*.tsx
