# Every text file is stored and checked out as LF so hashes and patches stay put.
* text=auto eol=lf

*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Renders, frames and archives are opaque bytes.
*.mp4  binary
*.wav  binary
*.png  binary
*.zip  binary
*.flac binary
